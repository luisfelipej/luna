# ─────────────────────────────────────────────────────────────────────────
# Luna — environment configuration
#
# Required variables are marked "REQUIRED". Booting without them fails fast
# with a zod validation error from `EnvSchema` in src/infra/config.
# ─────────────────────────────────────────────────────────────────────────

# ── Telegram ─────────────────────────────────────────────────────────────
# REQUIRED. Bot token issued by @BotFather.
TELEGRAM_BOT_TOKEN=

# REQUIRED. Comma-separated Telegram user ids allowed to message the bot.
# Any update from an unlisted user is silently dropped.
# Example: TELEGRAM_ALLOWED_IDS=123456789,987654321
TELEGRAM_ALLOWED_IDS=

# ── Filesystem ───────────────────────────────────────────────────────────
# REQUIRED. Every workspace (current + allow-listed) MUST realpath-resolve
# under this root. `/workspace-new <name>` mkdirs under it.
WORKSPACE_BASE=

# REQUIRED. SQLite DB, JSONL history, and crash-recovery flag files live
# under this directory. Auto-created on boot.
DATA_DIR=

# ── HTTP server ──────────────────────────────────────────────────────────
# Port for the Hono webhook + API server. Default 8080.
HTTP_PORT=8080

# Enables `POST /webhook/github`. Without it the route returns 503. Use a
# long random hex string; GitHub's delivery uses `x-hub-signature-256`.
GITHUB_WEBHOOK_SECRET=

# Enables `POST /webhook` AND bearer auth for `/api/*`. Without it the
# webhook returns 503 and `/api/*` returns 401.
GENERIC_WEBHOOK_SECRET=

# Optional. Public base URL for outbound links (informational only —
# Luna uses long-polling and has no reverse tunnel).
PUBLIC_URL=

# ── Backend config defaults (tier 5) ─────────────────────────────────────
# These are tier-5 defaults in the six-tier precedence (workspace DB →
# workspace YAML → user DB → users YAML → env → compiled defaults). A
# `/settings model opus` in Telegram writes a tier-3 row that overrides
# this for the chat.

# Model to spawn. `opus` | `sonnet` | `haiku`.
LUNA_MODEL=sonnet

# Per-turn timeout in seconds passed to `claude`. Default 300.
LUNA_TIMEOUT_S=300

# Running-total budget cap in USD. 0 disables the check. If the running
# total exceeds the cap, Luna replies "Budget exceeded." and refuses.
LUNA_BUDGET_USD=0

# Context-window hint forwarded to `claude`. Default 200_000 tokens.
LUNA_CONTEXT_WINDOW=200000

# ── Pool / eviction ──────────────────────────────────────────────────────
# Idle minutes before the backend pool evicts a per-chat subprocess.
IDLE_TIMEOUT_MIN=15

# ── Logging ──────────────────────────────────────────────────────────────
# `debug` | `info` | `warn` | `error`. `debug` is verbose (Pino JSON lines).
LOG_LEVEL=info
